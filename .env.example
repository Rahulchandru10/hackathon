# ─── Project Sentinel — Environment Variables ─────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=sentinelpass
POSTGRES_DB=sentinel_db

# ─── Neo4j ────────────────────────────────────────────────────────────────────
NEO4J_USER=neo4j
NEO4J_PASSWORD=sentinelneo4j

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=sentinelredis

# ─── Ollama / LLM ─────────────────────────────────────────────────────────────
# Options: qwen3:14b (default), qwen3:4b (lower resource), qwen3:32b (high quality)
OLLAMA_MODEL=qwen3:14b

# ─── Embeddings ───────────────────────────────────────────────────────────────
EMBEDDING_MODEL=BAAI/bge-m3

# ─── Search APIs ──────────────────────────────────────────────────────────────
# Serper: Get free key at https://serper.dev (2500 free searches/month)
SERPER_API_KEY=your_serper_api_key_here

# OpenSanctions: https://www.opensanctions.org/api/ (free tier available)
# Leave empty to use the public free-tier endpoint
OPENSANCTIONS_API_KEY=

# ─── Application ──────────────────────────────────────────────────────────────
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=changeme-use-strong-key-in-prod

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Environment: development, staging, production
ENVIRONMENT=development

# ─── Frontend ─────────────────────────────────────────────────────────────────
BACKEND_URL=http://localhost:8000

# ─── Monitoring ───────────────────────────────────────────────────────────────
# How often the monitoring scheduler checks for new articles (in minutes)
MONITORING_INTERVAL_MINUTES=60
